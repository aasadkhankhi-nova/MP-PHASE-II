# Server
PORT=4000
# Comma-separated allowed origins (your GitHub Pages URL)
CORS_ORIGINS=http://localhost:5173,https://YOUR-USERNAME.github.io

# Supabase Postgres (Project Settings -> Database -> Connection string, URI)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Gemini (server-side only — never in the frontend)
GEMINI_API_KEY=
